{
  "rules": {
    "users": {
      ".read": "auth != null && auth.token.email == 'help@pollslide.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || auth.token.email == 'help@pollslide.com')",
        ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'help@pollslide.com')",
        "aiUsedThisMonth": {
          ".validate": "newData.val() === data.val()"
        },
        "aiQuotaMonth": {
          ".validate": "newData.val() === data.val()"
        },
        "aiCredits": {
          ".validate": "newData.val() === data.val()"
        },
        "presentations": {
          "$presId": {
            ".read": "auth != null && root.child('deckGrants').child($uid).child($presId).child(auth.uid).exists()",
            ".write": "auth != null && root.child('deckGrants').child($uid).child($presId).child(auth.uid).val() === 'edit'"
          }
        },
        "classes": {
          "$classId": {
            "students": {
              "$studentId": {}
            }
          }
        },
        "tier": {
          ".validate": "newData.val() === data.val() || newData.val() === 'free' || auth.token.email === 'help@pollslide.com'"
        }
      }
    },
    "admin": {
      ".read": "auth != null && auth.token.email == 'help@pollslide.com'",
      "tickets": {
        ".indexOn": [
          "status",
          "createdAt",
          "lastUserReplyAt"
        ],
        ".write": "auth != null && auth.token.email == 'help@pollslide.com'",
        "$ticketId": {
          ".write": "auth != null && !data.exists() && $ticketId.matches(/^ticket_[0-9]+$/) && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'open' && (newData.child('email').val() === auth.token.email || newData.child('email').val() === '') && !newData.child('replies').exists() && !newData.child('replied').exists() && !newData.child('awaiting').exists()",
          "status": {
            ".write": "auth != null && data.parent().child('uid').val() === auth.uid && newData.val() === 'open'"
          },
          "awaiting": {
            ".write": "auth != null && data.parent().child('uid').val() === auth.uid && newData.val() === 'admin'"
          },
          "lastUserReplyAt": {
            ".write": "auth != null && data.parent().child('uid').val() === auth.uid && newData.isNumber() && newData.val() <= now + 300000"
          },
          "replies": {
            "$replyId": {
              ".write": "auth != null && !data.exists() && data.parent().parent().child('uid').val() === auth.uid && newData.child('from').val() === 'user' && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 5000 && !newData.child('by').exists() && !newData.child('emailedAt').exists() && !newData.child('emailError').exists()"
            }
          }
        }
      },
      "deletion_requests": {
        "$uid": {
          ".read": "auth != null && (auth.uid == $uid || auth.token.email == 'help@pollslide.com')",
          ".write": "auth != null && (auth.uid == $uid || auth.token.email == 'help@pollslide.com')"
        }
      },
      "$adminOther": {
        ".write": "auth != null && auth.token.email == 'help@pollslide.com'"
      }
    },
    "app_config": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'help@pollslide.com'"
    },
    "quiz_builder": {
      "$sessionCode": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "sessions": {
      "$sessionCode": {
        ".read": true,
        "responses": {
          ".write": true,
          "$qid": {
            "$pid": {
              ".validate": "(!newData.child('answer').exists() || (newData.child('answer').isString() && newData.child('answer').val().length <= 4000)) && (!newData.child('name').exists() || (newData.child('name').isString() && newData.child('name').val().length <= 60)) && (!newData.child('elapsed').exists() || newData.child('elapsed').isNumber())"
            }
          }
        },
        "attempts": {
          ".write": true
        },
        "currentQuestion": {
          ".write": "auth != null"
        },
        "qstate": {
          ".write": "auth != null"
        },
        "meta": {
          ".write": "auth != null"
        },
        "qa": {
          ".write": true,
          "$id": {
            ".validate": "(!newData.child('text').exists() || (newData.child('text').isString() && newData.child('text').val().length <= 300)) && (!newData.child('name').exists() || (newData.child('name').isString() && newData.child('name').val().length <= 60)) && (!newData.child('votes').exists() || newData.child('votes').isNumber())"
          }
        },
        "study": {
          ".write": true
        },
        "teams": {
          ".write": true,
          "$teamId": {
            ".validate": "newData.hasChild('name')",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            }
          }
        }
      }
    },
    "pairing": {
      "$code": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "mac_link": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "presentations": {
      ".read": false,
      ".write": false
    },
    "sharedDecks": {
      "$sid": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.child('owner').val() === auth.uid)",
        ".validate": "newData.hasChildren(['owner','title','json','at'])"
      }
    },
    "recaps": {
      "$rid": {
        ".read": true,
        ".write": "auth != null && (!data.exists() || data.child('owner').val() === auth.uid)",
        ".validate": "newData.hasChildren(['owner','title','at'])"
      }
    },
    "workspaces": {
      "$wsId": {
        ".read": "auth != null && (data.child('ownerUid').val() === auth.uid || data.child('members').child(auth.uid).exists())",
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || data.child('ownerUid').val() === auth.uid)",
        "members": {
          "$uid": {
            ".write": "auth != null && (data.parent().parent().child('ownerUid').val() === auth.uid || data.parent().parent().child('members').child(auth.uid).child('role').val() === 'admin' || ($uid === auth.uid && (!newData.exists() || (data.exists() && newData.child('role').val() === data.child('role').val()) || (!data.exists() && data.parent().parent().child('invites').child(auth.token.email.toLowerCase().replace('.', '_').replace('#', '_').replace('$', '_').replace('/', '_').replace('[', '_').replace(']', '_').replace('@', '_')).child('email').val() === auth.token.email.toLowerCase() && (newData.child('role').val() === data.parent().parent().child('invites').child(auth.token.email.toLowerCase().replace('.', '_').replace('#', '_').replace('$', '_').replace('/', '_').replace('[', '_').replace(']', '_').replace('@', '_')).child('role').val() || (newData.child('role').val() === 'member' && !data.parent().parent().child('invites').child(auth.token.email.toLowerCase().replace('.', '_').replace('#', '_').replace('$', '_').replace('/', '_').replace('[', '_').replace(']', '_').replace('@', '_')).child('role').exists()))))))",
            ".validate": "!newData.exists() || newData.hasChildren(['email','role'])"
          }
        },
        "invites": {
          "$emailKey": {
            ".write": "auth != null && (data.parent().parent().child('ownerUid').val() === auth.uid || data.parent().parent().child('members').child(auth.uid).child('role').val() === 'admin')"
          }
        },
        "tier": {
          ".validate": "newData.val() === data.val() || newData.val() === 'free' || newData.val() === root.child('users').child(auth.uid).child('tier').val() || (newData.val() === 'team_small' && root.child('users').child(auth.uid).child('tier').val() === 'team') || (newData.val() === 'team_large' && root.child('users').child(auth.uid).child('tier').val() === 'white') || auth.token.email === 'help@pollslide.com'"
        }
      }
    },
    "team_invites": {
      "$emailKey": {
        ".read": "auth != null",
        ".write": "auth != null && ((newData.exists() && (root.child('workspaces').child(newData.child('wsId').val() + '').child('ownerUid').val() === auth.uid || root.child('workspaces').child(newData.child('wsId').val() + '').child('members').child(auth.uid).child('role').val() === 'admin')) || (!newData.exists() && ($emailKey === auth.token.email.toLowerCase().replace('.', '_').replace('#', '_').replace('$', '_').replace('/', '_').replace('[', '_').replace(']', '_').replace('@', '_') || root.child('workspaces').child(data.child('wsId').val() + '').child('ownerUid').val() === auth.uid || root.child('workspaces').child(data.child('wsId').val() + '').child('members').child(auth.uid).child('role').val() === 'admin')) || auth.token.email === 'help@pollslide.com')"
      }
    },
    "shares": {
      ".read": false,
      ".write": false,
      ".indexOn": [
        "toEmailKey",
        "fromUid"
      ]
    },
    "deckGrants": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "$presId": {
          "$collabUid": {
            ".read": "auth != null && (auth.uid == $uid || auth.uid == $collabUid)",
            ".write": "auth != null && (auth.uid == $uid || (auth.uid == $collabUid && !newData.exists()))"
          }
        }
      }
    },
    "collabIndex": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "deckPresence": {
      "$ownerUid": {
        "$presId": {
          ".read": "auth != null && (auth.uid == $ownerUid || root.child('deckGrants').child($ownerUid).child($presId).child(auth.uid).exists())",
          ".write": "auth != null && (auth.uid == $ownerUid || root.child('deckGrants').child($ownerUid).child($presId).child(auth.uid).exists())"
        }
      }
    },
    "loops": {
      "$code": {
        ".read": true,
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid && newData.parent().parent().child('loop_slots').child(auth.uid).child(newData.child('slot').val() + '').val() === $code) || (data.exists() && data.child('ownerUid').val() === auth.uid && (!newData.exists() || newData.child('ownerUid').val() === auth.uid)))",
        ".validate": "!newData.exists() || (newData.hasChildren(['ownerUid','def']) && newData.child('ownerUid').isString() && (!data.exists() || newData.child('slot').val() === data.child('slot').val()) && (newData.child('cap').val() === 25 || (root.child('users').child(auth.uid).child('tier').val() === 'pro' || root.child('users').child(auth.uid).child('tier').val() === 'team_small' || root.child('users').child(auth.uid).child('tier').val() === 'team' || root.child('users').child(auth.uid).child('tier').val() === 'team_large' || root.child('users').child(auth.uid).child('tier').val() === 'white' || root.child('users').child(auth.uid).child('tier').val() === 'enterprise')) && (!data.child('suspended').exists() || newData.child('suspended').val() === data.child('suspended').val()))"
      }
    },
    "loop_answers": {
      "$code": {
        ".read": true,
        "$period": {
          "$key": {
            "$pid": {
              ".write": "!data.exists() && newData.exists() && root.child('loops').child($code).exists() && !root.child('loops').child($code).child('banned').child($pid).exists()",
              ".validate": "newData.hasChildren(['n','t']) && newData.child('n').isString() && newData.child('n').val().length >= 1 && newData.child('n').val().length <= 18 && newData.child('t').isNumber() && newData.child('t').val() <= now + 60000 && newData.child('t').val() >= now - 60000 && (!newData.child('pts').exists() || (newData.child('pts').isNumber() && newData.child('pts').val() >= 0 && newData.child('pts').val() <= 2000)) && (!newData.child('c').exists() || newData.child('c').isNumber()) && (!newData.child('ms').exists() || newData.child('ms').isNumber()) && (!newData.child('a').exists() || (newData.child('a').isString() && newData.child('a').val().length <= 8))",
              "x": {
                ".validate": "newData.isNumber() && (newData.val() === 1 || newData.val() === 2)"
              },
              "tm": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 12"
              }
            }
          }
        },
        ".write": "auth != null && root.child('loops').child($code).child('ownerUid').val() === auth.uid && !newData.exists()"
      }
    },
    "loop_scores": {
      "$code": {
        ".read": true,
        "$period": {
          "$pid": {
            ".write": "newData.exists() && root.child('loops').child($code).exists() && !root.child('loops').child($code).child('banned').child($pid).exists()",
            ".validate": "newData.hasChildren(['n','pts','ans','last']) && newData.child('n').isString() && newData.child('n').val().length >= 1 && newData.child('n').val().length <= 18 && newData.child('ans').isNumber() && newData.child('ans').val() === (data.exists() ? data.child('ans').val() + 1 : 1) && newData.child('pts').isNumber() && newData.child('pts').val() >= (data.exists() ? data.child('pts').val() : 0) && newData.child('pts').val() <= (data.exists() ? data.child('pts').val() : 0) + 2000 && newData.child('last').isString() && (!data.exists() || newData.child('last').val() !== data.child('last').val()) && root.child('loop_answers').child($code).child($period).child(newData.child('last').val()).child($pid).exists() && (!newData.child('a').exists() || (newData.child('a').isString() && newData.child('a').val().length <= 8))",
            "tm": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 12"
            },
            "b": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50"
            },
            "d": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3650"
            }
          }
        },
        ".write": "auth != null && root.child('loops').child($code).child('ownerUid').val() === auth.uid && !newData.exists()"
      }
    },
    "tv_pair": {
      "$code": {
        ".read": true,
        ".write": "(newData.exists() && (!data.exists() || data.child('createdAt').val() < now - 900000)) || (!newData.exists() && auth != null && newData.parent().parent().child('tv_devices').child(data.child('device').val()).child('pair').val() === $code)",
        ".validate": "$code.matches(/^[A-HJ-NP-Z2-9]{6}$/) && newData.hasChildren(['device','createdAt']) && newData.child('device').isString() && newData.child('device').val().matches(/^[A-Z0-9]{24}$/) && newData.child('createdAt').val() === now",
        "device": {
          ".validate": true
        },
        "createdAt": {
          ".validate": true
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "tv_devices": {
      "$device": {
        ".read": true,
        ".write": "auth != null && ((data.exists() && data.child('ownerUid').val() === auth.uid && (!newData.exists() || newData.child('ownerUid').val() === auth.uid)) || (!data.exists() && newData.child('ownerUid').val() === auth.uid && root.child('tv_pair').child(newData.child('pair').val() + '').child('device').val() === $device && root.child('tv_pair').child(newData.child('pair').val() + '').child('createdAt').val() > now - 900000 && newData.parent().parent().child('tv_slots').child(auth.uid).child(newData.child('slot').val() + '').val() === $device))",
        ".validate": "newData.hasChildren(['ownerUid','loop','name'])",
        "ownerUid": {
          ".validate": "newData.isString()"
        },
        "loop": {
          ".validate": "newData.isString() && root.child('loops').child(newData.val()).child('ownerUid').val() === auth.uid"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "pair": {
          ".validate": "newData.isString() && newData.val().length === 6"
        },
        "pairedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        },
        "slot": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        }
      }
    },
    "loop_slots": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$slot": {
          ".write": "auth != null && auth.uid === $uid && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists() && !newData.parent().parent().parent().child('loops').child(data.val() + '').exists()))",
          ".validate": "newData.isString() && ($slot === '0' || (root.child('users').child(auth.uid).child('tier').val() === 'pro' && $slot.matches(/^[0-4]$/)) || ((root.child('users').child(auth.uid).child('tier').val() === 'team_small' || root.child('users').child(auth.uid).child('tier').val() === 'team') && $slot.matches(/^1?[0-9]$/)) || ((root.child('users').child(auth.uid).child('tier').val() === 'team_large' || root.child('users').child(auth.uid).child('tier').val() === 'white') && $slot.matches(/^[1-7]?[0-9]$/)) || (root.child('users').child(auth.uid).child('tier').val() === 'enterprise' && $slot.matches(/^[0-9]{1,4}$/)))"
        }
      }
    },
    "tv_slots": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$slot": {
          ".write": "auth != null && auth.uid === $uid && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists() && !newData.parent().parent().parent().child('tv_devices').child(data.val() + '').exists()))",
          ".validate": "newData.isString() && ($slot === '0' || (root.child('users').child(auth.uid).child('tier').val() === 'pro' && $slot.matches(/^[0-2]$/)) || ((root.child('users').child(auth.uid).child('tier').val() === 'team_small' || root.child('users').child(auth.uid).child('tier').val() === 'team') && $slot.matches(/^[0-9]$/)) || ((root.child('users').child(auth.uid).child('tier').val() === 'team_large' || root.child('users').child(auth.uid).child('tier').val() === 'white') && $slot.matches(/^[1-3]?[0-9]$/)) || (root.child('users').child(auth.uid).child('tier').val() === 'enterprise' && $slot.matches(/^[0-9]{1,4}$/)))"
        }
      }
    },
    "loop_i18n": {
      "$code": {
        ".read": true,
        ".write": "auth != null && !newData.exists() && root.child('loops').child($code).child('ownerUid').val() === auth.uid"
      }
    },
    "loop_react": {
      "$code": {
        ".read": true,
        ".write": "auth != null && root.child('loops').child($code).child('ownerUid').val() === auth.uid && !newData.exists()",
        "$pid": {
          ".write": "newData.exists() && root.child('loops').child($code).exists() && !root.child('loops').child($code).child('banned').child($pid).exists() && $pid.matches(/^p[a-z0-9]{1,20}$/)",
          ".validate": "newData.hasChildren(['e','t']) && newData.child('e').isNumber() && newData.child('e').val() >= 0 && newData.child('e').val() <= 5 && newData.child('t').isNumber() && newData.child('t').val() <= now + 5000 && newData.child('t').val() >= now - 60000 && (!data.exists() || newData.child('t').val() >= data.child('t').val() + 1500)",
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
