<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd job: keeps the PollSlide converter running on this Mac.
     Install (see README step 5):
       cp com.pollslide.converter.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.pollslide.converter.plist
     Replace CHANGE-ME with the same secret you set as CONVERT_API_KEY on Vercel. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.pollslide.converter</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/Rod/Documents/GitHub/PollSlide/converter-service/server.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PORT</key><string>8790</string>
    <key>CONVERT_KEY</key><string>CHANGE-ME</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/pollslide-converter.log</string>
  <key>StandardErrorPath</key><string>/tmp/pollslide-converter.log</string>
</dict>
</plist>
